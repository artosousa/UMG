{% doc %}
  Renders the size guide block. Uses product metafield `custom.size_guide`.

  @param {object} product_object - Product to resolve size guide content from

  @example
  {% render 'size-guide', product_object: product %}
{% enddoc %}


{%- liquid  
    assign  chart_data = product_object.metafields.custom.size_guide
    assign size_data = chart_data.value
-%}

<div class="sizing-guide-wrapper">
    {%- if size_data.numerical -%}
        <div class="size-guide">
            <h3>{{ size_data.numerical.title }}</h3>
            <table>
                {%- for row in size_data.numerical.rows -%}
                    {%- if forloop.first -%}
                        <tr>
                            {%- for label in row -%}
                                <th>{{ label }}</th>
                            {%- endfor -%}
                        </tr>
                    {%- else -%}
                        <tr>
                          {%- for label in row -%}
                            <td>{{ label }}</td>
                          {%- endfor -%}
                        </tr>
                    {%- endif -%}
                {%- endfor -%}
            </table>
        </div>
    {%- elsif size_data.alpha -%}
        <div class="size-guide">
            <h3>{{ size_data.numerical.title }}</h3>
            <table>
                {%- for row in size_data.numerical.rows -%}
                    {%- if forloop.first -%}
                        <tr>
                            {%- for label in row -%}
                                <th>{{ label }}</th>
                            {%- endfor -%}
                        </tr>
                    {%- else -%}
                        <tr>
                          {%- for label in row -%}
                            <td>{{ label }}</td>
                          {%- endfor -%}
                        </tr>
                    {%- endif -%}
                {%- endfor -%}
            </table>
        </div>
    {%- endif -%}
</div>