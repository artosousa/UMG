{% doc %}
  @description
    Renders the size-guide drawer component.

  @param {string} drawer_id - A unique ID for the drawer element.
  @param {string} section_id - The ID of the parent section to ensure unique ARIA labeling.
  @param {string} block_id - The ID of the parent block (if applicable).
  @param {product} product - The product object to pull size guide data from.

  @example
    {% render 'size-guide-drawer' %}
{% enddoc %}
<script src="{{ 'size-guide-drawer.js' | asset_url }}" defer="defer"></script>
{{ 'component-size-guide-drawer.css' | asset_url | stylesheet_tag }}


<size-guide-drawer id="{{ drawer_id }}" class="drawer">
  <div class="size-guide-drawer__inner-wrapper size-guide-drawer">
    <div class="size-guide-drawer__overlay size-guide-drawer__overlay"></div>
    <div
      class="drawer__inner"
      role="dialog"
      aria-modal="true"
      aria-labelledby="SizeGuideDrawerHeading-{{ section_id }}-{{ block_id }}"
      tabindex="-1"
    >
      <div class="drawer__header">
        <h2 id="SizeGuideDrawerHeading-{{ section_id }}-{{ block_id }}" class="drawer__heading">
          Size guide
        </h2>
        <button
          type="button"
          class="drawer__close"
          onclick="this.closest('size-guide-drawer').close()"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {% render 'icon-close' %}
        </button>
      </div>
      <div class="drawer__contents size-guide-drawer__scroll">
        {% render 'size-guide', product_object: product %}
      </div>
    </div>
  </div>
</size-guide-drawer>